# --- Required ---
APP_URL=http://localhost:3000
# 32+ random chars: used to sign login sessions
SESSION_SECRET=change-me-to-a-long-random-string
# 32 bytes, base64 or 64 hex chars: encrypts Threads tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# --- Meta / Threads (https://developers.facebook.com/apps -> Threads use case) ---
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional shared secret for the Meta webhook verify handshake
THREADS_WEBHOOK_VERIFY_TOKEN=

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Use "1" to run without an API key (canned text, for UI testing only)
LLM_MOCK=0

# --- Safety switches ---
# "1" = never call the Threads publish endpoints; actions are logged only
DRY_RUN=1
ALLOW_SIGNUP=1

# --- Stripe (optional; leave empty to disable billing and unlock every plan) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Shown on the privacy policy and terms pages
CONTACT_EMAIL=support@yourdomain.com

# --- Storage ---
DATABASE_PATH=./data/threadsbyjoe.db
